# systemd unit for the HPP salary calculator on a VPS.
#   sudo cp deploy/amazoncalculate.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now amazoncalculate
# Adjust User/WorkingDirectory if you deploy to a different path or user.
[Unit]
Description=HPP Salary Calculator (Node API + static frontend)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/amazoncalculate
# node stays on localhost — nginx is the only public entry point
Environment=HOST=127.0.0.1
Environment=PORT=3000
# tells the rate limiter to trust the X-Real-IP header set by nginx
Environment=TRUST_PROXY=1
# privacy-friendly analytics: allows the Umami origin in the CSP.
# index.html loads the tracker from analytics.plp.ink — without this variable
# the CSP blocks both the script and the beacon and analytics silently dies.
# Set to your own Umami origin if you self-host elsewhere; comment out only
# together with removing the analytics <script> from index.html.
Environment=UMAMI_ORIGIN=https://analytics.plp.ink
ExecStart=/usr/bin/node api/server.js
Restart=on-failure
RestartSec=3
# light sandboxing, the app needs no special privileges
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/amazoncalculate

[Install]
WantedBy=multi-user.target
