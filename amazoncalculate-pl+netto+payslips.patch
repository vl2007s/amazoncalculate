From 6c9c43d4dfce9958b257f1ebc43958abe51abcc0 Mon Sep 17 00:00:00 2001
From: Kimi <kimi@dev>
Date: Mon, 14 Sep 2026 21:28:02 +0800
Subject: [PATCH 2/4] Fix net salary math: statutory rounding (health 13.5%/3
 up, social 7.1% up), taxpayer credit 2570 CZK (was wrong 3267)

---
 js/payroll.js | 15 ++++++++++-----
 1 file changed, 10 insertions(+), 5 deletions(-)

diff --git a/js/payroll.js b/js/payroll.js
index 7ab2b6c..0d0b001 100644
--- a/js/payroll.js
+++ b/js/payroll.js
@@ -247,13 +247,18 @@
     };
   }
 
-  /** Rough net from gross — Czech withholdings (health 4.5%, social 7.1%, 15% tax
-   *  with the monthly taxpayer credit, rounded like payroll software does). */
+  /** Net from gross — Czech withholdings, statutory rounding included:
+   *  - health: total 13.5% rounded UP to whole Kč, employee pays 1/3 (rounded UP)
+   *  - social: 7.1% rounded UP to whole Kč
+   *  - tax: base rounded UP to whole 100 Kč, 15%, minus the monthly taxpayer
+   *    credit 2 570 Kč (30 840 Kč/year, valid 2022–2026; previous 3 267 was wrong)
+   *  Verified against official worked examples (e.g. gross 28 520 -> SP 2 025,
+   *  ZP 1 284; gross 40 000 -> net 31 930). */
   function calcNetto(gross) {
-    const zdrav = round0(gross * 0.045);
-    const socialni = round0(gross * 0.071);
+    const zdrav = Math.ceil(Math.ceil(gross * 0.135) / 3);
+    const socialni = Math.ceil(gross * 0.071);
     const zaklad = Math.ceil(gross / 100) * 100;
-    const dan = Math.max(0, round0(zaklad * 0.15) - 3267);
+    const dan = Math.max(0, round0(zaklad * 0.15) - 2570);
     return gross - zdrav - socialni - dan;
   }
 
-- 
